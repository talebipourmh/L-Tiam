<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- هدر گرادیانی مشترک (مثل صفحه اصلی) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="18dp">

            <ImageView
                android:id="@+id/ivBackButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:src="@drawable/ic_back_arrow"
                app:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="بازگشت" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/app_logo"
                    android:adjustViewBounds="true"
                    android:tint="@android:color/white"
                    android:contentDescription="التیام" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="داروخانه"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- محتوای اصلی صفحه (جستجو + لیست) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#F5F5F5">

            <!-- جستجو -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill_white"
                android:gravity="center_vertical"
                android:paddingEnd="16dp"
                android:layout_marginBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="6dp"
                    android:text="جستجو"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/brand_blue"
                    android:textColor="@android:color/white" />

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="جستجوی دارو..."
                    android:background="@null"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:textSize="14sp"
                    android:gravity="center_vertical|start" />

            </LinearLayout>

            <!-- لیست داروها -->
            <ListView
                android:id="@+id/medicineListView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:scrollbarStyle="outsideInset" />

        </LinearLayout>

        <!-- نوار پایین ثابت + دکمه‌ی شناور خانه (فایل مشترک) -->
        <include
            layout="@layout/bottom_nav_with_fab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- دکمه شناور افزودن دارو -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddMedicine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="90dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:backgroundTint="@color/brand_green"
        android:contentDescription="افزودن داروی جدید" />

    <!-- پنل افزودن دارو، روی کل صفحه -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/addMedicinePanelScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/addMedicinePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ردیف عنوان + دکمه بستن -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="افزودن داروی جدید"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <ImageView
                    android:id="@+id/btnCloseForm"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="بستن فرم" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteMedicine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="نام دارو را انتخاب کنید 💊" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner
                android:id="@+id/spinnerDosage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpiryDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📅 انتخاب تاریخ انقضا"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/brand_blue"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="تعداد 🔢"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etDisease"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="بیماری مرتبط (اختیاری) 🩺" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etRoutine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="برنامه مصرف (اختیاری) ⏰" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="دستورات (اختیاری) 📝" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- دکمه ذخیره، فقط آیکون، وسط‌چین -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white"
                app:backgroundTint="@color/brand_green"
                android:contentDescription="ذخیره دارو" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>