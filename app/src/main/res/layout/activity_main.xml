<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="#F4F8FB">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- هدر گرادیانی -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_header_gradient"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/ivMenuToggle"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|start"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="@android:color/white"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="منو" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/app_logo"
                            android:adjustViewBounds="true"
                            android:tint="@android:color/white"
                            android:contentDescription="التیام" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ما کمک می‌کنیم دردها التیام پیدا کند."
                            android:textSize="11sp"
                            android:textColor="#DDEEFF"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </FrameLayout>

                <!-- محتوای اصلی -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- باکس یادآوری داروی بعدی -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardNextReminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layoutDirection="rtl"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/ivAlarmIcon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@android:drawable/ic_lock_idle_alarm"
                                app:tint="#FB8C00"
                                android:contentDescription="یادآوری دارو" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNextReminderLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="یادآوری داروی بعدی"
                                    android:textSize="11sp"
                                    android:textColor="#888888" />

                                <TextView
                                    android:id="@+id/tvNextReminderText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="یادآوری فعالی وجود ندارد"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#333333" />

                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ردیف اول باکس‌ها -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- باکس ۱ -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvBox1Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="#43A047" />

                                <TextView
                                    android:id="@+id/tvBox1Total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="از 0 مورد"
                                    android:textSize="11sp"
                                    android:textColor="#888888"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="داروی سالم"
                                    android:textSize="12sp"
                                    android:textColor="#555555"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/barBox1Fill"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.01"
                                        android:background="@drawable/bg_bar_fill_pill" />

                                    <View
                                        android:id="@+id/barBox1Spacer"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.99"
                                        android:background="@drawable/bg_bar_track_pill" />
                                </LinearLayout>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- باکس ۲ -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvBox2Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="#E53935" />

                                <TextView
                                    android:id="@+id/tvBox2Total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="از 0 مورد"
                                    android:textSize="11sp"
                                    android:textColor="#888888"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="داروی منقضی"
                                    android:textSize="12sp"
                                    android:textColor="#555555"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/barBox2Fill"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.01"
                                        android:background="@drawable/bg_bar_fill_pill" />

                                    <View
                                        android:id="@+id/barBox2Spacer"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.99"
                                        android:background="@drawable/bg_bar_track_pill" />
                                </LinearLayout>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- ردیف دوم باکس‌ها -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- باکس ۳ -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvBox3Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="#1E88E5" />

                                <TextView
                                    android:id="@+id/tvBox3Total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="از 0 مورد"
                                    android:textSize="11sp"
                                    android:textColor="#888888"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="اهدای تحویل‌شده"
                                    android:textSize="12sp"
                                    android:textColor="#555555"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/barBox3Fill"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.01"
                                        android:background="@drawable/bg_bar_fill_pill" />

                                    <View
                                        android:id="@+id/barBox3Spacer"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.99"
                                        android:background="@drawable/bg_bar_track_pill" />
                                </LinearLayout>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- باکس ۴ -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvBox4Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="#8E24AA" />

                                <TextView
                                    android:id="@+id/tvBox4Total"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="از 0 مورد"
                                    android:textSize="11sp"
                                    android:textColor="#888888"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="right"
                                    android:text="درخواست دریافت‌شده"
                                    android:textSize="12sp"
                                    android:textColor="#555555"
                                    android:layout_marginBottom="8dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/barBox4Fill"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.01"
                                        android:background="@drawable/bg_bar_fill_pill" />

                                    <View
                                        android:id="@+id/barBox4Spacer"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.99"
                                        android:background="@drawable/bg_bar_track_pill" />
                                </LinearLayout>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- هشدار درخواست‌های جدید -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardNearbyRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@android:drawable/ic_popup_reminder"
                                app:tint="#333333"
                                android:contentDescription="هشدار درخواست جدید" />

                            <TextView
                                android:id="@+id/tvNearbyRequestsText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:gravity="right"
                                android:text="۲ درخواست جدید در نزدیکی شما ثبت شده"
                                android:textSize="13sp"
                                android:textColor="#333333" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- نوار متن روان -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_marginTop="4dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">

                        <TextView
                            android:id="@+id/tvMedicineTicker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:textSize="13sp"
                            android:textColor="#444444"
                            android:singleLine="true"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                    </androidx.cardview.widget.CardView>

                    <!-- بنر پایین -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="120dp">

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/bannerViewPager"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:id="@+id/bannerDotsLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:orientation="horizontal" />

                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- نوار پایین ثابت + دکمه‌ی شناور خانه (فایل مشترک) -->
        <include
            layout="@layout/bottom_nav_with_fab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/activity_main_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>