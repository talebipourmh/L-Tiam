<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- هدر گرادیانی مشترک (مثل صفحه اصلی) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="18dp">

            <ImageView
                android:id="@+id/ivBackButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:src="@drawable/ic_back_arrow"
                app:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="بازگشت" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/app_logo"
                    android:adjustViewBounds="true"
                    android:tint="@android:color/white"
                    android:contentDescription="التیام" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="یادآوری"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- محتوای اصلی صفحه: فقط لیست برنامه‌های مصرف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#F5F5F5">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 داروهای در حال مصرف"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/listViewSchedules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp" />

        </LinearLayout>

        <!-- نوار پایین ثابت + دکمه‌ی شناور خانه (فایل مشترک) -->
        <include
            layout="@layout/bottom_nav_with_fab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- دکمه شناور افزودن برنامه مصرف -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="90dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:backgroundTint="@color/brand_green"
        android:contentDescription="افزودن برنامه مصرف" />

    <!-- پنل افزودن برنامه مصرف، روی کل صفحه -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/addSchedulePanelScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ردیف عنوان + دکمه بستن -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="افزودن برنامه مصرف"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <ImageView
                    android:id="@+id/btnCloseScheduleForm"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="بستن فرم" />

            </LinearLayout>

            <!-- جستجو/انتخاب دارو، به‌شکل پیل مثل صفحه داروخانه -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill_white"
                android:gravity="center_vertical"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchMedicine"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_margin="6dp"
                    android:text="جستجو"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/brand_blue"
                    android:textColor="@android:color/white" />

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteMedicine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="نام دارو را تایپ کنید..."
                    android:background="@null"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:textSize="14sp"
                    android:gravity="center_vertical|start" />

            </LinearLayout>

            <!-- نمایش موجودی دارو -->
            <TextView
                android:id="@+id/tvStockStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <!-- دوز مصرفی -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etDosage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="💊 دوز مصرفی (مثلاً 1 قرص)"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- تعداد کل -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etTotalQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="📦 تعداد کل تجویز شده"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- فاصله زمانی -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="⏰ فاصله زمانی (ساعت)"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- یادآوری مجدد -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:hintEnabled="false"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etRetryMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:hint="⏰ یادآوری مجدد (دقیقه) - 0 = غیرفعال"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- باکس انتخاب ساعت شروع: کلیک روی آن ساعت آنالوگ باز می‌کند -->
            <TextView
                android:id="@+id/btnPickTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_pill_white"
                android:text="🕐 انتخاب ساعت شروع"
                android:textSize="14sp"
                android:textColor="#555555"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp" />

            <!-- دکمه ذخیره، فقط آیکون، وسط‌چین -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSaveSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white"
                app:backgroundTint="@color/brand_green"
                android:contentDescription="ذخیره برنامه مصرف" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>