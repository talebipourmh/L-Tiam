<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- هدر گرادیانی مشترک (مثل صفحه اصلی) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:padding="18dp">

        <ImageView
            android:id="@+id/ivBackButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:src="@drawable/ic_back_arrow"
            app:tint="@android:color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="بازگشت" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/app_logo"
                android:adjustViewBounds="true"
                android:tint="@android:color/white"
                android:contentDescription="التیام" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="درخواست‌های دارو"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- محتوای اصلی صفحه -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F5F5F5">

        <!-- بخش جستجو و فیلتر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteMedicine"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="🔍 نام دارو را جستجو کنید..."
                android:inputType="text"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerProvince"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerCity"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F44336"
            android:padding="8dp"
            android:visibility="gone"
            android:textAlignment="center"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/listViewRequests"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="1dp"
            android:padding="4dp" />

    </LinearLayout>

    <!-- نوار پایین ثابت + دکمه‌ی شناور خانه (فایل مشترک) -->
    <include
        layout="@layout/bottom_nav_with_fab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>